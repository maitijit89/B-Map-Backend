# App Configuration
APP_ENV=development
APP_PORT=8080
APP_NAME="B Map"
APP_URL=http://localhost:8080
APP_VERSION=0.1.2

# Server Port & Core Settings
PORT=8080
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY_HOURS=72

# Admin Configuration
ADMIN_EMAIL=admin@example.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/b_map_db?authSource=admin
DB_HOST=cluster0.example.mongodb.net
DB_PORT=27017
DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=b_map_db

# Redis Cache (Upstash Cloud / Local)
REDIS_URL=rediss://default:<password>@national-bug-258874.upstash.io:6379
REDIS_HOST=national-bug-258874.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=bmap:
REDIS_ROUTE_CACHE_TTL_SECONDS=3600
OTP_EXPIRY_MINUTES=5

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=b_map_uploads

# Google Maps Platform Credentials
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key
GOOGLE_PLACES_API_KEY=AIzaSy_your_google_places_api_key
GOOGLE_MAPS_API_SECRET=your_google_maps_api_secret

# SMTP Configuration for Gmail OTP Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="B Map"

# Server Keep-Alive / Anti-Sleep Heartbeat
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_MINUTES=2

# OSRM Routing Engine
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_DEFAULT_PROFILE=driving
OSRM_TIMEOUT_MS=8000

# Navigation Settings
OFF_ROUTE_THRESHOLD_METERS=40
REROUTE_COOLDOWN_SECONDS=5
