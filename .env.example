# App Configuration
APP_ENV=development
APP_PORT=8080
APP_NAME=B-Map-Backend
APP_URL=http://localhost:8080

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_b_map_2026
JWT_EXPIRY_HOURS=72

# PostgreSQL Database (PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=b_map_db
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
OTP_EXPIRY_MINUTES=5

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=b_map_uploads
