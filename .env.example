# App Configuration
APP_ENV=development
APP_PORT=8080
APP_NAME="B Map"
APP_URL=http://localhost:8080
APP_VERSION=0.1.2

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_b_map_2026
JWT_EXPIRY_HOURS=72

# Admin Configuration
ADMIN_EMAIL=maitidebjit2@gmail.com
MONGODB_URI=mongodb://localhost:27017/b_map_db
DB_HOST=localhost
DB_PORT=27017
DB_USER=
DB_PASSWORD=
DB_NAME=b_map_db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
OTP_EXPIRY_MINUTES=5

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=b_map_uploads

# Google Maps Platform Credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_MAPS_API_SECRET=your_google_maps_api_secret

# SMTP Configuration for Gmail OTP Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_username@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_gmail_username@gmail.com
SMTP_FROM_NAME=B Map

# Server Keep-Alive / Anti-Sleep Heartbeat (Every 2 minutes)
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_MINUTES=2
